# Copy this file to .env.local, then fill in your own secrets.

# OpenAI-compatible API settings.
# For Alibaba Cloud DashScope compatible mode, use:
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_MODEL=qwen-plus
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=qwen-plus
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MAX_TOKENS=1800

# Backward-compatible single QQ Mail settings.
# QQ Mail requires an IMAP/SMTP authorization code, not your QQ password.
QQ_EMAIL_ADDRESS=your_qq_email@qq.com
QQ_EMAIL_AUTH_CODE=your_qq_mail_imap_authorization_code
QQ_IMAP_HOST=imap.qq.com
QQ_IMAP_PORT=993
QQ_MAILBOX=INBOX

# Optional multi-mailbox settings.
# If EMAIL_ACCOUNT_1_ADDRESS exists, the app reads EMAIL_ACCOUNT_N_* accounts
# instead of the single QQ_EMAIL_* account above.
# EMAIL_ACCOUNT_1_LABEL=Work QQ
# EMAIL_ACCOUNT_1_ADDRESS=your_email@example.com
# EMAIL_ACCOUNT_1_AUTH_CODE=your_mail_imap_authorization_code
# EMAIL_ACCOUNT_1_IMAP_HOST=imap.example.com
# EMAIL_ACCOUNT_1_IMAP_PORT=993
# EMAIL_ACCOUNT_1_MAILBOX=INBOX
#
# EMAIL_ACCOUNT_2_LABEL=Client mailbox
# EMAIL_ACCOUNT_2_ADDRESS=client@example.com
# EMAIL_ACCOUNT_2_AUTH_CODE=client_mail_imap_authorization_code
# EMAIL_ACCOUNT_2_IMAP_HOST=imap.example.com
# EMAIL_ACCOUNT_2_IMAP_PORT=993
# EMAIL_ACCOUNT_2_MAILBOX=INBOX

# Agent behavior.
EMAIL_AGENT_TIMEZONE=Asia/Shanghai
EMAIL_AGENT_MAX_EMAILS=80
EMAIL_AGENT_FETCH_WORKERS=4
EMAIL_AGENT_OUTPUT_DIR=outputs
